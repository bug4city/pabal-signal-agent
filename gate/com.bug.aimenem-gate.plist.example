<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bug.aimenem-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE_PATH</string>
    <string>AGENT_DIR/gate/tick.js</string>
  </array>
  <key>WorkingDirectory</key><string>AGENT_DIR</string>
  <key>StandardOutPath</key><string>LOG_DIR/aimenem-gate.log</string>
  <key>StandardErrorPath</key><string>LOG_DIR/aimenem-gate.log</string>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
